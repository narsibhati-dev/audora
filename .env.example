# Copy this file to .env and fill in values before running.
# Do NOT commit .env to version control.

# Database 
# Password for the Postgres container user (audora_user)
POSTGRES_PASSWORD=change_me_to_a_secure_password
# Must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://audora_user:change_me_to_a_secure_password@database:5432/audora

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_to_a_random_secret
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Frontend (Next.js public vars) ──────────────────────────────────────────
# These are embedded at build time and exposed to the browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HTTP_URL=http://localhost:9000
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8000
# Google Analytics (optional)
NEXT_PUBLIC_MEASUREMENT_ID=

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=9000
FRONTEND_URL=http://localhost:3000

# Kafka (recording pipeline) 
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=recording-chunks

# Signal Server 
DEBUG=false

# General 
NODE_ENV=development
